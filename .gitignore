# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android 子目录的构建产物（根 /build/ 规则覆盖不到这里）
/android/build/
**/build/reports/
**/.cxx/

# ===== 开源前必须排除的本机敏感配置 =====
# 含本机 Android SDK / Flutter 路径，换电脑会失效，切勿提交
android/local.properties
**/local.properties
# 签名密钥与密码（即便当前用 debug 签名也预先排除，防止误提交）
**/*.jks
**/*.keystore
**/key.properties
android/app/*.jks
android/app/key.properties
# 环境变量 / 密钥文件
.env
.env.*
*.pem
*.p12
